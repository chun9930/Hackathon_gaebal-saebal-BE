DB_URL=jdbc:h2:mem:mcm_private_circle;MODE=MySQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
JPA_DDL_AUTO=update
H2_CONSOLE_ENABLED=true

